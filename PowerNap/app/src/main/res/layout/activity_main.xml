<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POWER NAP LAB"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="IDLE"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/feedbackPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Czy udało Ci się zasnąć?"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <Button
                android:id="@+id/feedbackYes"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:text="TAK" />

            <Button
                android:id="@+id/feedbackNo"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:text="NIE" />
        </LinearLayout>

        <Button
            android:id="@+id/startButton"
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="START" />

        <TextView
            android:id="@+id/metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="HR -- | RMSSD --\nMotion -- | confidence --"
            android:textColor="#CCCCCC"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/engineTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="READ ENGINE"
            android:textColor="#888888"
            android:textSize="9sp" />

        <Spinner
            android:id="@+id/engineSpinner"
            android:layout_width="210dp"
            android:layout_height="44dp"
            android:spinnerMode="dialog" />

        <Switch
            android:id="@+id/loggingSwitch"
            android:layout_width="210dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Record sensor data"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/provider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="active: --\nselected: --"
            android:textColor="#AAAAAA"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/logStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:text="recording: --"
            android:textColor="#AAAAAA"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:maxLines="4"
            android:text=""
            android:textColor="#AAAAAA"
            android:textSize="9sp" />

        <Button
            android:id="@+id/permissionsButton"
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:text="PERMISSIONS" />

        <Button
            android:id="@+id/exactAlarmButton"
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:text="EXACT ALARM" />

    </LinearLayout>
</ScrollView>
