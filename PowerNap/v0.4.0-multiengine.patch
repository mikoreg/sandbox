diff -ruN PowerNap-v0.3.0-user-test/scripts/reproduce-known-legacy-false-positive.sh PowerNap-v0.4.0-multiengine/scripts/reproduce-known-legacy-false-positive.sh
--- PowerNap-v0.3.0-user-test/scripts/reproduce-known-legacy-false-positive.sh	1970-01-01 00:00:00.000000000 +0000
+++ PowerNap-v0.4.0-multiengine/scripts/reproduce-known-legacy-false-positive.sh	2026-09-25 12:07:14.862624812 +0000
@@ -0,0 +1,16 @@
+#!/usr/bin/env bash
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+FILE="$ROOT/powernap-sessions/20260925-131932-000-false-positive.csv"
+if [[ ! -f "$FILE" ]]; then
+  echo "Missing $FILE" >&2
+  exit 2
+fi
+OUT="$($ROOT/scripts/replay-detector.sh "$FILE")"
+printf '%s\n' "$OUT"
+if grep -q '^onset=' <<<"$OUT"; then
+  echo "KNOWN LIMITATION REPRODUCED: Legacy HR+ACC still reports sleep for this awake session."
+  exit 0
+fi
+echo "Legacy no longer reproduces the known false positive; review detector changes."
+exit 1
